{%- comment -%}
  Section 05 — Sticky Storytelling
  Apple-style: text steps scroll while the media panel stays sticky.
  GSAP ScrollTrigger crossfades media panels as each step enters view.
  Falls back to stacked layout on mobile and when animations are disabled.
{%- endcomment -%}

{%- liquid
  assign media_right = true
  if section.settings.layout == 'left'
    assign media_right = false
  endif
-%}

<section
  {% if section.settings.background_color != blank %}style="background-color: {{ section.settings.background_color }};"{% endif %}
  data-sticky-storytelling="{{ section.id }}"
>
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="mx-auto max-w-2xl px-6 py-16 text-center md:py-20">
      {%- if section.settings.subheading != blank -%}
        <p class="mb-3 text-sm font-medium uppercase tracking-widest text-secondary">
          {{- section.settings.subheading | escape -}}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="text-3xl md:text-5xl">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="lg:grid lg:grid-cols-2">

    {%- comment -%} Steps column {%- endcomment -%}
    <div class="{% unless media_right %}lg:order-2{% endunless %}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign step_num = forloop.index | prepend: '0'
          assign step_label = step_num | slice: -2, 2
        -%}
        <div
          class="flex min-h-screen flex-col justify-center px-8 py-20 md:px-16 lg:px-20"
          data-story-step="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          {%- comment -%} Inline media — mobile only, hidden on desktop {%- endcomment -%}
          {%- if block.settings.video != blank or block.settings.image != blank -%}
            <div class="mb-10 overflow-hidden rounded-xl lg:hidden">
              {%- if block.settings.video != blank -%}
                {%- render 'video',
                  video: block.settings.video,
                  autoplay: true,
                  loop: true,
                  controls: false,
                  class: 'w-full aspect-[4/3] object-cover'
                -%}
              {%- else -%}
                {%- render 'responsive-image',
                  image: block.settings.image,
                  class: 'w-full aspect-[4/3] object-cover'
                -%}
              {%- endif -%}
            </div>
          {%- endif -%}

          <span class="mb-4 block text-xs font-medium uppercase tracking-[0.2em] text-secondary">
            {{ step_label }}
          </span>

          {%- if block.settings.title != blank -%}
            <h2 class="mb-5 text-3xl leading-tight md:text-4xl lg:text-5xl">
              {{ block.settings.title | escape }}
            </h2>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <div class="max-w-md text-base text-secondary md:text-lg">
              {{ block.settings.description }}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} Sticky media column — desktop only {%- endcomment -%}
    <div class="relative hidden lg:block{% if media_right %}{% else %} lg:order-1{% endif %}">
      <div class="sticky top-0 h-screen overflow-hidden">
        {%- for block in section.blocks -%}
          <div
            class="absolute inset-0"
            data-story-panel="{{ forloop.index0 }}"
            style="opacity: {% if forloop.first %}1{% else %}0{% endif %};"
          >
            {%- if block.settings.video != blank -%}
              {%- render 'video',
                video: block.settings.video,
                autoplay: true,
                loop: true,
                controls: false,
                class: 'h-full w-full object-cover'
              -%}
            {%- elsif block.settings.image != blank -%}
              {%- render 'responsive-image',
                image: block.settings.image,
                class: 'h-full w-full object-cover'
              -%}
            {%- else -%}
              <div class="flex h-full w-full items-center justify-center bg-surface">
                {{ 'image' | placeholder_svg_tag: 'h-32 w-32 opacity-30' }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

  </div>
</section>

<script src="{{ 'sticky-storytelling.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:sections.sticky-storytelling.name",
  "tag": "section",
  "class": "section-sticky-storytelling",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.sticky-storytelling.settings.subheading.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.sticky-storytelling.settings.heading.label"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.sticky-storytelling.settings.layout.label",
      "options": [
        {
          "value": "right",
          "label": "t:sections.sticky-storytelling.settings.layout.options__1.label"
        },
        {
          "value": "left",
          "label": "t:sections.sticky-storytelling.settings.layout.options__2.label"
        }
      ],
      "default": "right"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.sticky-storytelling.settings.background_color.label",
      "info": "t:sections.sticky-storytelling.settings.background_color.info"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:sections.sticky-storytelling.blocks.step.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.sticky-storytelling.blocks.step.settings.title.label",
          "default": "t:sections.sticky-storytelling.blocks.step.settings.title.default"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "t:sections.sticky-storytelling.blocks.step.settings.description.label",
          "default": "t:sections.sticky-storytelling.blocks.step.settings.description.default"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.sticky-storytelling.blocks.step.settings.image.label"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.sticky-storytelling.blocks.step.settings.video.label",
          "info": "t:sections.sticky-storytelling.blocks.step.settings.video.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.sticky-storytelling.presets.name",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
