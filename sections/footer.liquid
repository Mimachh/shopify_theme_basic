{%- comment -%}
  Section 22 — Luxury Footer
  Logo, footer navigation menus (one per block), social links and a
  newsletter signup form.
{%- endcomment -%}

{%- liquid
  assign logo = section.settings.logo
  assign logo_width = section.settings.logo_width
  assign current_year = 'now' | date: '%Y'
-%}

<footer class="border-t border-surface" {%- if section.settings.background_color != blank %} style="background-color: {{ section.settings.background_color }};"{% endif %}>
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex flex-col gap-12 md:flex-row md:justify-between">
      <div class="flex flex-col gap-4 md:max-w-xs">
        {%- if logo != blank -%}
          <div style="width: {{ logo_width }}px;">
            {%- render 'responsive-image', image: logo, class: 'h-auto w-full' -%}
          </div>
        {%- else -%}
          <p class="font-heading text-xl">{{ shop.name }}</p>
        {%- endif -%}

        {%- render 'social-links' -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="flex flex-wrap gap-x-12 gap-y-8 md:flex-1 md:justify-center">
          {%- for block in section.blocks -%}
            {%- liquid
              assign menu_heading = block.settings.heading
              assign menu = block.settings.menu
            -%}
            <div class="flex flex-col gap-3" {{ block.shopify_attributes }}>
              {%- if menu_heading != blank -%}
                <p class="text-sm font-semibold tracking-wide text-text">{{ menu_heading }}</p>
              {%- elsif menu != blank -%}
                <p class="text-sm font-semibold tracking-wide text-text">{{ menu.title }}</p>
              {%- endif -%}

              {%- if menu != blank -%}
                <ul class="flex flex-col gap-2">
                  {%- for link in menu.links -%}
                    <li>
                      <a href="{{ link.url }}" class="text-sm text-secondary transition-colors hover:text-text">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="flex flex-col gap-4 md:max-w-sm">
        {%- if section.settings.newsletter_heading != blank -%}
          <p class="text-sm font-semibold tracking-wide text-text">{{ section.settings.newsletter_heading }}</p>
        {%- endif -%}

        {%- if section.settings.newsletter_text != blank -%}
          <div class="text-sm text-secondary">{{ section.settings.newsletter_text }}</div>
        {%- endif -%}

        {%- form 'customer', class: 'flex flex-wrap gap-2' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="sr-only" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.email_label' | t }}</label>
          <input
            type="email"
            name="contact[email]"
            id="NewsletterEmail-{{ section.id }}"
            value="{{ form.email }}"
            placeholder="{{ 'newsletter.email_placeholder' | t }}"
            autocomplete="email"
            required
            class="flex-1 rounded-full border border-secondary bg-background px-4 py-2 text-sm text-text placeholder:text-secondary focus:border-accent focus:outline-none"
          >
          <button type="submit" class="btn btn-primary">{{ 'newsletter.submit' | t }}</button>

          {%- if form.posted_successfully? -%}
            <p class="w-full text-sm text-accent">{{ 'newsletter.success' | t }}</p>
          {%- else -%}
            {{ form.errors | default_errors }}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <div class="mt-12 border-t border-surface pt-8 text-sm text-secondary">
      <p>{{ 'footer.copyright' | t: year: current_year, shop: shop.name }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.footer.settings.logo.label"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 10,
      "unit": "px",
      "default": 140,
      "label": "t:sections.footer.settings.logo_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.newsletter_header.content"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:sections.footer.settings.newsletter_heading.label",
      "default": "Stay in touch"
    },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "label": "t:sections.footer.settings.newsletter_text.label",
      "default": "<p>Sign up for early access and exclusive offers.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.footer.settings.background_color.label",
      "info": "t:sections.footer.settings.background_color.info"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.menu.settings.heading.label",
          "info": "t:sections.footer.blocks.menu.settings.heading.info"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.menu.settings.menu.label",
          "default": "footer"
        }
      ]
    }
  ]
}
{% endschema %}
